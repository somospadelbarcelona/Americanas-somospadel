rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNCIONES AUXILIARES (CORE SECURITY)
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role Claim rápido sin lecturas extra
    function hasClaimRole(roles) {
      return isAuthenticated() && 
             request.auth.token.keys().hasAny(['role']) && 
             request.auth.token.role in roles;
    }

    // Fallback seguro leyendo el documento de perfil durante la transición
    function hasDocRole(roles) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/players/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role in roles;
    }

    // Administradores y organizadores oficiales con plenos privilegios de gestión
    function isStaff() {
      return hasClaimRole(['admin', 'admin_player', 'super_admin', 'superadmin', 'organizador', 'organizer', 'organizador_bcn', 'organizer_bcn']) ||
             hasDocRole(['admin', 'admin_player', 'super_admin', 'superadmin', 'organizador', 'organizer', 'organizador_bcn', 'organizer_bcn']);
    }

    // Compatibilidad retroactiva: isAdmin ahora delega a isStaff
    function isAdmin() {
      return isStaff();
    }

    // Capitanes de equipo (privilegios delegados exclusivamente a convocatorias e informes)
    function isCaptain() {
      return hasClaimRole(['captain', 'capitan', 'capitanes']) ||
             hasDocRole(['captain', 'capitan', 'capitanes']);
    }

    // Verifica si el documento pertenece al usuario autenticado
    function isOwner(playerId) {
      return isAuthenticated() && request.auth.uid == playerId;
    }

    // ==========================================
    // REGLAS PARA JUGADORES (PII PROTECTION & ZERO-TRUST)
    // ==========================================
    match /players/{playerId} {
      allow read: if isAuthenticated(); 
      
      // Creación de perfil: solo staff o el propio usuario autenticado creando su propio UID
      allow create: if isStaff() || (
        isOwner(playerId) &&
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['player', 'player_americanas', 'player_somospadel']) &&
        (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['active', 'pending']) &&
        (!request.resource.data.keys().hasAny(['isSessionAdmin']) || request.resource.data.isSessionAdmin == false)
      );
      
      // Bloqueamos la edición de roles, niveles y flags de sesión a usuarios normales
      allow update: if isStaff() || 
                    (isOwner(playerId) && 
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'level', 'self_rate_level', 'isSessionAdmin']));
      
      allow delete: if isStaff();
      
      match /notifications/{notificationId} {
          allow read: if isOwner(playerId) || isStaff();
          // Creación controlada: Staff o el propio usuario en su cajón o notificación interna autenticada
          allow create: if isAuthenticated();
          allow update, delete: if isOwner(playerId) || isStaff();
      }
      
      match /devices/{deviceId} {
          allow read: if isOwner(playerId) || isStaff();
          // Registro seguro de dispositivos: SOLO el propio usuario en su subcolección o Staff
          allow write: if isOwner(playerId) || isStaff();
      }

      match /captain_reports/{reportId} {
          allow read: if isOwner(playerId) || isStaff() || isCaptain();
          allow write: if isOwner(playerId) || isStaff() || isCaptain();
      }
    }

    // ==========================================
    // REGLAS PARA EVENTOS (AMERICANAS & ENTRENOS)
    // ==========================================
    match /americanas/{eventId} {
      allow read: if isAuthenticated();
      allow create, delete: if isStaff();
      
      // Staff tiene libre edición; usuarios normales solo pueden auto-inscribirse o desapuntarse
      allow update: if isStaff() || (
        isAuthenticated() && 
        resource.data.status == 'open' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'registeredPlayers', 'waitlist', 'fixed_pairs'])
      );
    }

    match /entrenos/{eventId} {
      allow read: if isAuthenticated();
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        isAuthenticated() && 
        resource.data.status == 'open' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'registeredPlayers', 'waitlist', 'fixed_pairs'])
      );
    }

    // ==========================================
    // REGLAS PARA PARTIDOS (INTEGRIDAD)
    // ==========================================
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create, delete: if isStaff();
      allow update: if isStaff() || 
                    (isAuthenticated() && (
                      request.auth.uid in resource.data.get('team_a_ids', []) || 
                      request.auth.uid in resource.data.get('team_b_ids', []) ||
                      request.auth.uid in resource.data.get('players', [])
                    ));
    }
    
    match /entrenos_matches/{matchId} {
      allow read: if isAuthenticated();
      allow create, delete: if isStaff();
      allow update: if isStaff() || 
                    (isAuthenticated() && (
                      request.auth.uid in resource.data.get('team_a_ids', []) || 
                      request.auth.uid in resource.data.get('team_b_ids', []) ||
                      request.auth.uid in resource.data.get('players', [])
                    ));
    }

    // ==========================================
    // COMUNICACIÓN (CHATS)
    // ==========================================
    match /chats/{chatId} {
      allow read: if isAuthenticated();
      // Solo participantes del chat o Staff pueden crear o actualizar el documento principal
      allow create, update: if isStaff() || (
        isAuthenticated() && (
          !resource.data.keys().hasAny(['participants']) ||
          request.auth.uid in resource.data.participants ||
          request.auth.uid in request.resource.data.participants
        )
      );
      allow delete: if isStaff();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        // El emisor debe coincidir exactamente con el usuario autenticado
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow delete: if isStaff() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
        allow update: if isStaff() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
      }

      match /presence/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isStaff();
      }
    }

    // ==========================================
    // EQUIPOS DEL CLUB (REAL-TIME TEAMS & SCRAPER)
    // ==========================================
    match /club_teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isCaptain();
    }

    // ==========================================
    // TORNEOS (GESTOR DE TORNEOS)
    // ==========================================
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ==========================================
    // PARTIDOS ABIERTOS (COMUNIDAD)
    // ==========================================
    match /open_matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creator_id == request.auth.uid;
      // Actualización: Staff, creador, o jugadores gestionando su propia plaza en el array 'slots'
      allow update: if isStaff() || 
                    (isAuthenticated() && (
                      resource.data.creator_id == request.auth.uid ||
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots'])
                    ));
      allow delete: if isStaff() || (isAuthenticated() && resource.data.creator_id == request.auth.uid);
    }

    // ==========================================
    // MENÚS Y ELEMENTOS DE NAVEGACIÓN
    // ==========================================
    match /menu_items/{menuId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ==========================================
    // HISTORIAL DE NIVELES (GRÁFICOS DE EVOLUCIÓN)
    // ==========================================
    match /level_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isStaff() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isStaff();
    }

    // ==========================================
    // COMUNICADOS GLOBALES DEL CLUB (BROADCASTS)
    // ==========================================
    match /broadcasts/{broadcastId} {
      allow read: if true;
      // Solo el staff/administración puede emitir comunicados oficiales del club
      allow create, update, delete: if isStaff();
    }

    // ==========================================
    // CONFIGURACIÓN DEL SISTEMA
    // ==========================================
    match /system_config/{configId} {
      allow read: if true;
      // Purgado de notificaciones permitido para usuarios autenticados; el resto de configs son exclusivas de Staff
      allow update, create: if isStaff() || (
        isAuthenticated() && configId == 'purged_notifications'
      );
      allow delete: if isStaff();
    }

    // ==========================================
    // METADATOS Y DIAGNÓSTICO
    // ==========================================
    match /system_metadata/{metaId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ==========================================
    // LOGS DE AUDITORÍA PUSH Y TELEMETRÍA (FCM / APNs)
    // ==========================================
    match /push_delivery_logs/{logId} {
      allow read: if isStaff();
      allow write: if isAuthenticated() || isStaff();
    }

    // ==========================================
    // MULTI-TENANT ORGANIZACIONES (CLUBES Y SEDES)
    // ==========================================
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isStaff();

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isStaff();
      }
    }

    // ==========================================
    // LEADERBOARDS & RANKINGS PRECALCULADOS (0-COST READS)
    // ==========================================
    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ==========================================
    // RED DE LIGAS Y CIRCUITOS INTERCLUBES (FASE 3)
    // ==========================================
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if isStaff();

      match /fixtures/{fixtureId} {
        allow read: if true;
        allow write: if isStaff() || isCaptain();
      }

      match /standings/{standingId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    // Regla global de cierre: solo Staff
    match /{allPaths=**} {
      allow read, write: if isStaff();
    }
  }
}
