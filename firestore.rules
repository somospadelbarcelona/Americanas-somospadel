rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNCIONES AUXILIARES (CORE SECURITY)
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario tiene rol de administrador
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role in ['admin', 'admin_player', 'super_admin', 'superadmin', 'organizador_bcn', 'organizer_bcn', 'captain', 'organizer', 'organizador', 'collaborator'];
    }

    // Verifica si el documento pertenece al usuario autenticado
    function isOwner(playerId) {
      return isAuthenticated() && request.auth.uid == playerId;
    }

    // ==========================================
    // REGLAS PARA JUGADORES (PII PROTECTION & ZERO-TRUST)
    // ==========================================
    match /players/{playerId} {
      allow read: if isAuthenticated(); 
      
      // Creación de perfil: admin o auto-registro de jugador o sesión de administrador
      allow create: if isAdmin() || (
        isAuthenticated() && (
          (request.resource.data.keys().hasAny(['isSessionAdmin']) && request.resource.data.isSessionAdmin == true) ||
          (isOwner(playerId) &&
           (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'player') &&
           (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['active', 'pending']))
        )
      );
      
      // Bloqueamos la edición de roles, niveles y flags de sesión a usuarios normales
      allow update: if isAdmin() || 
                    (isOwner(playerId) && 
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'level', 'self_rate_level', 'isSessionAdmin']));
      
      allow delete: if isAdmin();
      
      match /notifications/{notificationId} {
          allow read: if isOwner(playerId) || isAdmin() || (isAuthenticated() && request.auth.uid == playerId);
          allow create: if isAuthenticated() || isAdmin();
          allow update, delete: if isOwner(playerId) || isAdmin();
      }
      
      match /devices/{deviceId} {
          allow read: if isOwner(playerId) || isAdmin();
          // Permitir registro resiliente de token push garantizando propiedad de dispositivo o UID
          allow write: if isOwner(playerId) || isAdmin() || 
                        (request.resource.data.deviceId == deviceId && 
                         request.resource.data.token is string && 
                         request.resource.data.token.size() > 5);
      }
    }

    // ==========================================
    // REGLAS PARA EVENTOS (AMERICANAS & ENTRENOS)
    // ==========================================
    match /americanas/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      // Permitir auto-inscripción controlada
      allow update: if isAuthenticated() && 
                    resource.data.status == 'open' &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'registeredPlayers', 'waitlist']));
    }

    match /entrenos/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow update: if isAuthenticated() && 
                    resource.data.status == 'open' &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'registeredPlayers', 'waitlist']));
    }

    // ==========================================
    // REGLAS PARA PARTIDOS (INTEGRIDAD)
    // ==========================================
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
                    (isAuthenticated() && (
                      request.auth.uid in resource.data.get('team_a_ids', []) || 
                      request.auth.uid in resource.data.get('team_b_ids', []) ||
                      request.auth.uid in resource.data.get('players', [])
                    ));
    }
    
    match /entrenos_matches/{matchId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
                    (isAuthenticated() && (
                      request.auth.uid in resource.data.get('team_a_ids', []) || 
                      request.auth.uid in resource.data.get('team_b_ids', []) ||
                      request.auth.uid in resource.data.get('players', [])
                    ));
    }

    // ==========================================
    // COMUNICACIÓN (CHATS)
    // ==========================================
    match /chats/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        // Solo el emisor puede borrar su rastro
        allow create: if isAuthenticated();
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
        allow update: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // ==========================================
    // EQUIPOS DEL CLUB (REAL-TIME TEAMS & SCRAPER)
    // ==========================================
    match /club_teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // TORNEOS (GESTOR DE TORNEOS)
    // ==========================================
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // PARTIDOS ABIERTOS (COMUNIDAD)
    // ==========================================
    match /open_matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.creator_id == request.auth.uid);
    }

    // ==========================================
    // MENÚS Y ELEMENTOS DE NAVEGACIÓN
    // ==========================================
    match /menu_items/{menuId} {
      allow read: if true; // Permitir lectura incluso sin autenticar para la UI inicial
      allow write: if isAdmin();
    }

    // ==========================================
    // HISTORIAL DE NIVELES (GRÁFICOS DE EVOLUCIÓN)
    // ==========================================
    match /level_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // COMUNICADOS GLOBALES DEL CLUB (BROADCASTS)
    // ==========================================
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // CONFIGURACIÓN DEL SISTEMA (PURGED NOTIFS, METADATOS)
    // ==========================================
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // ==========================================
    // LOGS DE AUDITORÍA PUSH Y TELEMETRÍA (FCM / APNs)
    // ==========================================
    match /push_delivery_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Regla global de cierre
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
