rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNCIONES AUXILIARES (CORE SECURITY)
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario tiene rol de administrador en su documento de perfil
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role in ['admin', 'admin_player', 'super_admin'];
    }

    // Verifica si el documento pertenece al usuario autenticado
    function isOwner(playerId) {
      return isAuthenticated() && request.auth.uid == playerId;
    }

    // ==========================================
    // REGLAS PARA JUGADORES (PII & ROLES)
    // ==========================================
    match /players/{playerId} {
      // Permitimos lectura a usuarios autenticados para que funcione el Ranking y búsquedas.
      // NOTA: Se recomienda en el futuro mover datos sensibles (como hashes de pass) a una subcolección privada.
      allow read: if isAuthenticated(); 
      
      // Registro inicial: Cualquier usuario autenticado puede crear su perfil.
      allow create: if isAuthenticated();
      
      // SEGURIDAD CRÍTICA: 
      // 1. Los admins pueden editar todo.
      // 2. Los usuarios solo pueden editar su perfil PERO NO campos sensibles que alteren la integridad (Nivel, Rol, Estado).
      allow update: if isAdmin() || 
                    (isOwner(playerId) && 
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'level', 'self_rate_level']));
      
      // SOLO los admins pueden borrar jugadores.
      allow delete: if isAdmin();
      
      match /notifications/{notificationId} {
          allow read: if isOwner(playerId) || isAdmin();
          allow create: if isAuthenticated();
          allow update, delete: if isOwner(playerId) || isAdmin();
      }
    }

    // ==========================================
    // REGLAS PARA EVENTOS (AMERICANAS & ENTRENOS)
    // ==========================================
    match /americanas/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      // Permitir a jugadores inscribirse/desinscribirse si el evento está abierto
      allow update: if isAuthenticated() && 
                    resource.data.status == 'open' &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'registeredPlayers', 'waitlist']));
    }

    match /entrenos/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow update: if isAuthenticated() && 
                    resource.data.status == 'open' &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'registeredPlayers', 'waitlist']));
    }

    // ==========================================
    // REGLAS PARA PARTIDOS (INTEGRIDAD DE RESULTADOS)
    // ==========================================
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
                    (isAuthenticated() && (
                      request.auth.uid in resource.data.get('team_a_ids', []) || 
                      request.auth.uid in resource.data.get('team_b_ids', []) ||
                      request.auth.uid in resource.data.get('players', [])
                    ));
    }
    
    match /entrenos_matches/{matchId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
                    (isAuthenticated() && (
                      request.auth.uid in resource.data.get('team_a_ids', []) || 
                      request.auth.uid in resource.data.get('team_b_ids', []) ||
                      request.auth.uid in resource.data.get('players', [])
                    ));
    }

    // ==========================================
    // MISCELÁNEA (CONFIG & MENÚS)
    // ==========================================
    match /menu_items/{itemId} {
      allow read: if true; // El menú suele ser visible antes del login completo o para invitados
      allow write: if isAdmin();
    }
    
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // SISTEMA DE CHATS (COMUNICACIÓN)
    // ==========================================
    match /chats/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAdmin();
        // Solo el emisor puede editar su mensaje o un admin
        allow update: if isAuthenticated() && 
                      (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }
    
    // Regla de seguridad final: denegar todo lo que no esté explícitamente permitido
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}

