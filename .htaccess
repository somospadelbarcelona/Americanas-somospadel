# ==============================================================================
# 🎾 SOMOSPADEL - OPTIMIZACIÓN DE SERVIDOR (Apache / LiteSpeed / cPanel)
# ==============================================================================

# 1. COMPRESIÓN GZIP / BROTLI (Acelera la descarga de 97 scripts JS y CSS hasta un 75%)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml application/vnd.ms-fontobject application/x-font-ttf font/opentype
</IfModule>

# 2. CABECERAS DE CACHÉ (Evita recargar una y otra vez archivos pesados)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML y Service Worker: No cachear agresivamente para recibir siempre actualizaciones
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/manifest+json "access plus 1 day"

    # Imágenes y Multimedia: Caché extendida
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 month"
</IfModule>

# 3. SEGURIDAD: PROTEGER ARCHIVOS SENSIBLES Y OCULTOS
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Bloquear acceso a archivos y carpetas ocultas (.git, .env, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F]
    
    # Evitar acceso directo a node_modules o carpetas de testing si quedaron en el servidor
    RewriteRule ^(node_modules|functions/node_modules|tests|scraper|tools|admin_tools)/ - [F,L]
</IfModule>

# Desactivar listado de directorios
Options -Indexes
